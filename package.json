{
  "name": "testimonials-grid",
  "version": "1.0.0",
  "source": "src/index.html",
  "description": "Bento style testimonials grid section",
  "scripts": {
    "start": "npx parcel --host 0.0.0.0 --port 4321 --dist-dir dist-dev",
    "build": "npm run cleanup && npx parcel build --public-url ./",
    "push-gh": "npm run build && gh-pages --dist dist --branch gh-pages",
    "cleanup": "rm -rf dist dist-dev .parcel-cache"
  },
  "keywords": [
    "web development",
    "frontend mentor",
    "css",
    "sass",
    "parcel",
    "github pages"
  ],
  "author": "Jason Sherrick",
  "license": "MIT",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.13.3",
    "gh-pages": "^6.3.0",
    "parcel": "^2.16.4",
    "prettier": "^3.4.2",
    "svgo": "^3.3.2"
  },
  "allowScripts": {
    "@parcel/transformer-sass@2.16.4": true,
    "prettier@3.8.4": true,
    "svgo@3.3.3": true,
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.15.43": true,
    "lmdb@2.8.5": true,
    "msgpackr-extract@3.0.4": true
  }
}
